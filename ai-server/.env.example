# Independent choices. All four combinations are supported.
REASONING_PROVIDER=cloud
EMBEDDING_PROVIDER=local

# Cloud reasoning AND cloud embeddings use Gemini, independently.
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemini-3.6-flash"
EMBEDDING_MODEL_NAME="gemini-embedding-001"
CLOUD_REASONING_REQUESTS_PER_MINUTE=5

# Local models. Download embeddings: ollama pull nomic-embed-text
OLLAMA_BASE_URL="http://localhost:11434"
LOCAL_REASONING_MODEL="llama3.2:3b"
LOCAL_EMBEDDING_MODEL="nomic-embed-text"

# Fixed by the current pgvector schema. Changing embedding models requires reindexing.
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_REQUESTS_PER_MINUTE=10
EMBEDDING_MAX_ATTEMPTS=5
EMBEDDING_RETRY_BASE_SECONDS=2
EMBEDDING_RETRY_MAX_SECONDS=60
EMBEDDING_MAX_CHARS=6000

LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=4096
RCA_MAX_ROUNDS=3
RCA_MAX_LLM_CALLS=24
RCA_MAX_TOOL_CALLS=30
RCA_MAX_ROLE_STEPS=4
RCA_MAX_SECONDS=600
RCA_MAX_CONTEXT_CHARS=18000
AGTR_MAX_CANDIDATES=40
AGTR_LLM_CANDIDATES=10
RCA_JOB_MAX_ATTEMPTS=2
JOB_POLL_SECONDS=2

DATABASE_URL="postgresql://postgres:change-me@localhost:5433/codelens"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="change-me"
LOG_LEVEL="INFO"
LOG_FILE="logs/ai-server.log"
PORT=8000

# Local CPU inference: constrained JSON and a longer request timeout.
LOCAL_JSON_SCHEMA=true
LOCAL_LLM_TIMEOUT_SECONDS=180
